  {{--
    =====================================================
    MA MÉTHODE
    =====================================================
  --}}
  <section
    id="projects-method"
    aria-labelledby="projects-method-title"
    class="relative overflow-hidden px-4 py-12 text-dark sm:px-8 sm:py-16 lg:px-10 lg:py-20"
  >
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 sm:gap-14 lg:gap-16">
      {{-- Introduction --}}
      <div class="content-column flex flex-col">
        <h2 id="projects-method-title" class="h2-brown">
          Une même logique, des compétences complémentaires.
        </h2>

        <p class="top-paragraph">
          Qu’il s’agisse de développement web ou de marketing digital, je commence par comprendre le besoin, structurer les idées et définir une direction claire avant de passer à la réalisation.
        </p>
      </div>
      {{-- Étapes --}}
      <div class="mx-auto grid w-full max-w-4xl gap-6 sm:grid-cols-3 sm:gap-8">
        <article class="method-item">
          <span class="card-highlight" aria-hidden="true">01</span>

          <h3 class="method-title">Comprendre</h3>

          <p class="card-description">
            Identifier le besoin, le contexte, les utilisateurs et les objectifs du projet.
          </p>
        </article>

        <article class="method-item">
          <span class="card-highlight" aria-hidden="true">02</span>

          <h3 class="method-title">Concevoir</h3>

          <p class="card-description">
            Organiser les idées et construire une solution cohérente, claire et réalisable.
          </p>
        </article>

        <article class="method-item">
          <span class="card-highlight" aria-hidden="true">03</span>

          <h3 class="method-title">Améliorer</h3>

          <p class="card-description">
            Tester, analyser les résultats et ajuster la solution selon les retours.
          </p>
        </article>
      </div>
    </div>
  </section>
