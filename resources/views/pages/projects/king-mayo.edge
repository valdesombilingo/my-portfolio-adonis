  {{-- 5. OFFRE PRODUIT --}}
  {{-- ========================================================= --}}
  <section
    id="project-products"
    aria-labelledby="project-products-title"
    class="relative overflow-hidden px-5 py-16 text-dark sm:px-8 sm:py-20 lg:px-10 lg:py-24"
  >
    <div class="mx-auto w-full max-w-5xl">
      <div class="mx-auto max-w-3xl lg:px-6">
        <h2
          id="project-products-title"
          class="mt-3 font-heading text-2xl font-semibold leading-tight text-brown sm:text-3xl"
        >
          Construire des plats autour des usages, pas seulement autour du poulet.
        </h2>

        <p class="mt-6 font-body font-medium leading-7 text-dark-gray sm:leading-8">
          La gamme a été élargie avec des produits signatures tel que le Shawarmayo et des combos pensés pour différents contextes de consommation : déjeuner rapide, repas généreux entre amis, formules à partager ou commande familiale. L’objectif était de proposer une offre plus flexible, plus lisible et plus facilement valorisable sur les canaux digitaux.
        </p>
      </div>
      {{-- Galerie plats --}}
{{-- Visuel produit --}}
<figure class="mx-auto mt-10 w-full max-w-sm overflow-hidden rounded-xl sm:mt-12">
  <img
