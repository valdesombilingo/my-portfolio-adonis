@let(title = 'X Clone | Application web fullstack - Valdes Ombilingo')
@let(description =
  'Découvrez X Clone, une application web fullstack inspirée du réseau social X, développée avec AdonisJS 6, TypeScript, PostgreSQL et Tailwind CSS.')
@let(ogImage = 'https://valdesombilingo.com/images/meta/x-clone-og.jpg')
@let(ogImageAlt = 'Présentation du projet X Clone développé par Valdes Ombilingo')
@let(robots = 'noindex, follow')
@projectLayout({
  title,
  description,
  canonical: 'https://valdesombilingo.com/projets/x-clone',
  ogImage,
  ogImageAlt,
  robots,
})
  {{-- RETOUR AUX PROJETS --}}
  @!backNav()
  {{-- ========================================================= --}}
  {{-- HERO PROJET --}}
  {{-- ========================================================= --}}
  @!projectHero({
    title: 'X Clone',
    year: '2025',
    type: 'Projet chef-d’œuvre',
    role: 'Développeur web fullstack junior',

    image: '/images/projects/x-clone/x-clone-background-project.webp',
    imageAlt: 'Présentation de l’application X Clone',

    projectUrl: 'https://github.com/valdesombilingo/clone_x_adonis',
    ctaProject: 'Voir sur GitHub',

    participants: [
      {
        name: 'Valdes Ombilingo',
        image: '/images/projects/participants/valdes-ombilingo-avatar.webp',
      },
    ],

    skills: ['AdonisJS 6', 'TypeScript', 'PostgreSQL', 'Tailwind CSS'],
  })
  {{-- ========================================================= --}}
  {{-- CONTENU À VENIR --}}
  {{-- ========================================================= --}}
  @!projectComingSoon({
    text: 'Le contenu détaillé de ce projet sera bientôt disponible.',
  })
@end
