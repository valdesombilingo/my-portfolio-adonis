          class="group relative flex h-[380px] flex-col justify-between overflow-hidden rounded-3xl p-6 transition duration-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brown sm:h-[440px] sm:p-10 lg:h-[500px] lg:hover:-translate-y-1 lg:hover:shadow-2xl lg:hover:shadow-black/20"
        >
          <img
            src="/public/images/projects/king-mayo-background.webp"
            alt="Vue desktop du menu moderne et chaleureux du restaurant King Mayo"
            aria-hidden="true"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out lg:group-hover:scale-110"
            loading="lazy"
          />

          <div class="absolute inset-0" aria-hidden="true"></div>

          <div class="relative z-10 w-full text-dark">
            <h3 class="mb-2 font-heading text-2xl font-bold">King Mayo</h3>

            <p class="max-w-md font-body text-sm leading-6 text-dark-gray">
              Fast-food à Kinshasa spécialisé dans le poulet mayo.
            </p>
          </div>

          <div class="relative z-10 w-full">
            <span class="inline-flex items-center gap-1 text-sm font-medium text-dark">
              
              En savoir plus

              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 576 512"
                class="size-3.5 pt-1 transition-transform duration-200 lg:group-hover:translate-x-1"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M566.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-128-128c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L466.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l434.7 0-73.4 73.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l128-128z"
                />
