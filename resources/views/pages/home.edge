@layout()
  <section id="home-hero" class="relative overflow-hidden px-5 text-dark sm:px-8 lg:px-10">
    <div
      class="mx-auto flex w-full max-w-7xl flex-col items-center justify-center gap-12 pt-16 lg:gap-20 lg:pt-20"
    >
      {{-- Titre principal --}}
      <h1 class="font-heading text-center text-5xl leading-none text-dark sm:text-6xl lg:text-5xl">
        {{-- Commentaire fixe avec texte dynamique --}}
        <span
          class="mb-2 block text-left font-code text-base font-normal tracking-normal text-gray-custom opacity-90 sm:text-lg"
        >
          //
          <span id="welcome-text"></span>
        </span>
        <span class="block font-bold">C'est <span class="text-brown font-bold">Valdes.</span></span>
      </h1>
      {{-- Image et texte --}}
      <div
        class="mx-auto grid w-full max-w-4xl items-center gap-12 pb-16 sm:pb-20 lg:grid-cols-[280px_minmax(0,560px)] lg:justify-center lg:gap-22 lg:pb-24"
      >
        {{-- Partie image --}}
        <div class="flex w-full justify-center">
          <div class="relative w-full lg:max-w-70 sm:max-w-140">
            {{-- Décoration derrière l’image --}}
            <div
              aria-hidden="true"
              class="absolute -inset-4 rounded-4xl bg-brown/10 blur-2xl"
            ></div>

            <figure
              class="relative overflow-hidden rounded-4xl border border-very-light-gray bg-light-beige shadow-sm"
            >
              <img
                src="/images/photo-profil-valdes-ombilingo.png"
                alt="Portrait de Valdes Ombilingo"
                width="560"
                height="700"
                class="aspect-4/5 w-full object-cover object-top"
              />

              <figcaption class="border-t border-very-light-gray px-5 py-5">
                <blockquote class="font-quote text-xl leading-snug text-dark sm:text-xl">
                  "Ce que nous savons est une goutte d’eau ; ce que nous ignorons est un océan."
                </blockquote>

                <p class="mt-3 font-body text-sm text-gray-custom">— Isaac Newton</p>
              </figcaption>
            </figure>
          </div>
        </div>
        {{-- Partie texte --}}
        <div class="mx-auto flex w-full max-w-140 flex-col lg:mx-0">
          <h2 class="font-heading text-2xl leading-tight font-semibold text-brown sm:text-3xl">
            Développeur web et spécialiste en marketing digital.
          </h2>

          <h3 class="mt-2 font-heading font-medium text-md leading-6 text-dark sm:text-lg">
            Basé à Kinshasa (RDC), la ville la plus animée d'Afrique.
          </h3>

          <p class="mt-6 font-body font-medium text-md leading-6 text-dark-gray sm:leading-8">
            Profil hybride, je transforme les idées en solutions digitales utiles grâce au développement web et au marketing digital. À travers des projets concrets, je conçois des sites web et des applications web performants et responsives, en associant stratégie digitale et compréhension des besoins réels des utilisateurs.
          </p>
          {{-- Disponibilité --}}
          <p class="mt-4 font-body font-medium text-md leading-6 text-dark-gray sm:leading-8">
            Disponible pour un stage, une expérience professionnelle ou de nouvelles opportunités dans le développement web et le marketing digital.
          </p>
          {{-- Boutons --}}
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="{{ route('experience') }}"
              class="inline-flex min-h-11 items-center justify-center rounded-full bg-green-custom border border-green-custom px-6 py-3 font-body text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-custom"
            >
              Découvrir mon parcours
            </a>
            <a
              href="{{ route('projects') }}"
              class="inline-flex min-h-11 items-center justify-center rounded-full border border-light-gray bg-white/80 px-6 py-3 font-body text-sm font-medium text-dark backdrop-blur-sm transition duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-sm hover:shadow-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-light-gray"
            >
              Mes projets
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
@end
