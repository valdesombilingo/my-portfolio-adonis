@layout()
  {{-- SECTION HERO --}}
  {{-- 1. Suppression de overflow-hidden pour laisser l'ombre de la photo visible --}}
  <section id="home-hero" class="relative px-5 text-dark sm:px-8 lg:px-10">
    <div
      class="mx-auto flex w-full max-w-7xl flex-col items-center justify-center gap-12 pb-16 pt-16 sm:pb-20 sm:pt-20 lg:gap-16 lg:pb-24 lg:pt-24"
    >
      {{-- Titre principal --}}
      <h1 class="text-center font-heading text-5xl font-bold leading-none text-dark sm:text-6xl">
        <span class="block">C'est <span class="text-brown">Valdes.</span></span>
      </h1>
      {{-- Image et texte --}}
      <div
        class="mx-auto grid w-full max-w-4xl items-center gap-12 lg:grid-cols-[280px_minmax(0,560px)] lg:justify-center lg:gap-20"
      >
        {{-- Partie image --}}
        <div class="flex w-full justify-center">
          <div class="relative w-full max-w-[320px] sm:max-w-[360px] lg:max-w-[280px]">
            {{-- Décoration derrière l’image --}}
            <div
              aria-hidden="true"
              class="absolute -inset-4 rounded-4xl bg-brown/10 blur-2xl"
            ></div>

            <figure
              class="relative mx-auto w-full max-w-md overflow-hidden rounded-4xl border border-very-light-gray bg-light-beige shadow-xs sm:max-w-xl lg:max-w-[560px]"
            >
              <img
                src="/images/photo-profil-valdes-ombilingo.webp"
                alt="Portrait de Valdes Ombilingo sur un fond bleu clair, portant une chemise blanche"
                width="560"
                height="700"
                class="h-[320px] w-full object-cover object-center sm:h-[420px] lg:aspect-[4/5] lg:h-auto lg:object-top"
                fetchpriority="high"
              />

              <figcaption class="border-t border-very-light-gray px-5 py-5 sm:px-8 sm:py-6">
                <blockquote class="font-quote text-xl leading-snug text-dark">
                  “Ce que nous savons est une goutte d’eau ; ce que nous ignorons est un océan.”
                </blockquote>

                <p class="mt-3 font-body text-sm text-gray-custom">— Isaac Newton</p>
              </figcaption>
            </figure>
          </div>
        </div>
        {{-- Partie texte --}}
        <div class="mx-auto flex w-full max-w-[560px] flex-col lg:mx-0">
          <h2 class="font-heading text-2xl font-semibold leading-tight text-brown sm:text-3xl">
            Développeur web et spécialiste en marketing digital.
          </h2>

          <h3 class="mt-2 font-heading text-base font-medium leading-6 text-dark sm:text-lg">
            Basé à Kinshasa (RDC), la ville la plus animée d'Afrique.
          </h3>

          <p class="mt-6 font-body text-base font-medium leading-6 text-dark-gray sm:leading-8">
            Je transforme les idées en solutions digitales utiles grâce au développement web et au marketing digital. À travers des projets concrets, je conçois des sites web et des applications web performants et responsives, en associant stratégie digitale et compréhension des besoins réels des utilisateurs.
          </p>
          {{-- Disponibilité --}}
          <p class="mt-4 font-body text-base font-medium leading-6 text-dark-gray sm:leading-8">
            Disponible pour un stage, une expérience professionnelle ou de nouvelles opportunités dans le développement web et le marketing digital.
          </p>
          {{-- Boutons --}}
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="{{ route('experience') }}"
              class="inline-flex min-h-11 items-center justify-center rounded-full border border-green-custom bg-green-custom px-6 py-3 font-body text-sm font-semibold text-white transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-custom lg:hover:-translate-y-0.5 lg:hover:shadow-md"
            >
              Découvrir mon parcours
            </a>
            <a
              href="{{ route('projects') }}"
              class="inline-flex min-h-11 items-center justify-center rounded-full border border-light-gray bg-white/80 px-6 py-3 font-body text-sm font-medium text-dark backdrop-blur-sm transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-light-gray lg:hover:-translate-y-0.5 lg:hover:bg-white"
            >
              Mes projets
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  {{-- SECTION PROJETS --}}
  <section
    id="home-projects"
    class="relative overflow-hidden px-5 py-16 text-dark sm:px-8 lg:px-10"
  >
    <div class="flex flex-col gap-16 lg:gap-20">
      {{-- Texte --}}
      <div class="mx-auto flex max-w-3xl flex-col lg:px-6">
        <h2 class="font-heading text-2xl font-semibold leading-tight text-brown sm:text-3xl">
          Du concept à l’écran, j'interviens sur plusieurs dimensions d’un projet digital.
        </h2>

        <p class="mt-6 font-body font-medium leading-6 text-dark-gray sm:leading-8">
          Chaque projet commence par une question simple : quel problème résoudre, pour qui, et comment y apporter une solution adaptée ?
        </p>
        <p class="mt-6 font-body font-medium leading-6 text-dark-gray sm:leading-8">
          Mes projets reflètent cette approche entre développement web et marketing digital. Je peux créer des sites et applications web fullstack, de l’interface à la base de données, mais aussi construire une stratégie digitale, travailler la visibilité en ligne, gérer des campagnes digitales et analyser les performances pour améliorer les résultats.
        </p>
      </div>
      {{-- Cards projets --}}
      <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-8 md:grid-cols-2 lg:gap-12">
        {{-- Projet 1 --}}
        <a
          href="#"
          aria-label="Voir le projet X Clone"
          class="group relative flex h-[380px] flex-col justify-between overflow-hidden rounded-3xl p-6 transition duration-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brown sm:h-[440px] sm:p-10 lg:h-[500px] lg:hover:-translate-y-1 lg:hover:shadow-2xl lg:hover:shadow-black/20"
        >
          <img
            src="/images/projects/x-background.webp"
            alt="Aperçu mobile (Iphone 14 Pro Max) de l'interface utilisateur du réseau social X Clone avec le fil d'actualité en mode sombre"
            aria-hidden="true"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out lg:group-hover:scale-105"
            loading="lazy"
          />

          <div class="absolute" aria-hidden="true"></div>

          <div class="relative z-10 w-full text-dark">
            <h3 class="mb-2 font-heading text-2xl font-bold">X Clone</h3>

            <p class="max-w-md font-body text-sm leading-6 text-dark-gray">
              Application web fullstack inspirée du réseau social X.
            </p>
          </div>

          <div class="relative z-10 w-full">
            <span class="inline-flex items-center gap-1 text-sm font-medium text-dark">
              
              
              
              
              
              
              
              En savoir plus







              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 576 512"
                class="size-3.5 pt-1 transition-transform duration-200 lg:group-hover:translate-x-1"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M566.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-128-128c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L466.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l434.7 0-73.4 73.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l128-128z"
                />
              </svg>
            </span>
          </div>
        </a>
        {{-- Projet 2 --}}
        <a
          href="{{ route('projects.king_mayo') }}"
          up-follow
          aria-label="Voir le projet King Mayo"
          class="group relative flex h-[380px] flex-col justify-between overflow-hidden rounded-3xl p-6 transition duration-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brown sm:h-[440px] sm:p-10 lg:h-[500px] lg:hover:-translate-y-1 lg:hover:shadow-2xl lg:hover:shadow-black/20"
        >
          <img
            src="/images/projects/king-mayo-background.webp"
            alt="Vue desktop du menu moderne et chaleureux du restaurant King Mayo"
            aria-hidden="true"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out lg:group-hover:scale-105"
            loading="lazy"
          />

          <div class="absolute inset-0" aria-hidden="true"></div>

          <div class="relative z-10 w-full text-dark">
            <h3 class="mb-2 font-heading text-2xl font-bold">King Mayo</h3>

            <p class="max-w-md font-body text-sm leading-6 text-dark-gray">
              Fast-food à Kinshasa spécialisé dans le poulet mayo.
            </p>
          </div>

          <div class="relative z-10 w-full">
            <span class="inline-flex items-center gap-1 text-sm font-medium text-dark">
              
              
              
              
              
              
              
              En savoir plus







              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 576 512"
                class="size-3.5 pt-1 transition-transform duration-200 lg:group-hover:translate-x-1"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M566.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-128-128c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L466.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l434.7 0-73.4 73.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l128-128z"
                />
              </svg>
            </span>
