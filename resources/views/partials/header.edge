@let(navLinks = [
  { route: 'home', label: 'Accueil' },
  { route: 'experience', label: 'Parcours' },
  { route: 'projects', label: 'Projets' },
  { route: 'contact', label: 'Contact' },
])
{{--
  =========================================================
  OVERLAY MOBILE
  =========================================================
--}}
<div
  id="mobile-menu-overlay"
  class="pointer-events-none fixed inset-0 z-40 bg-dark/70 opacity-0 backdrop-blur-xs transition-opacity duration-300 ease-out md:hidden"
  aria-hidden="true"
></div>
{{--
  =========================================================
  HEADER
  =========================================================
--}}
<header id="site-header" class="sticky top-0 z-50 mx-4 pt-4 sm:mx-8 lg:mx-12">
  <div
    id="header-container"
    class="mx-auto w-full max-w-4xl overflow-hidden transition-[background-color,backdrop-filter,border-radius] duration-300 ease-out"
  >
    {{--
      =====================================================
      BARRE PRINCIPALE
      =====================================================
    --}}
    <div class="flex min-h-12 items-center justify-between px-5 sm:px-6">
      {{-- LOGO --}}
      <a
        href="{{ route('home') }}"
        up-follow
        class="shrink-0 font-body text-lg font-bold text-brown active:scale-[0.98] md:active:scale-100"
        aria-label="Accueil"
      >
        Valdes.
      </a>
      {{--
        =====================================================
        NAVIGATION TABLETTE / DESKTOP
        =====================================================
      --}}
      <nav class="hidden flex-1 md:block" aria-label="Navigation principale">
        <ul class="flex items-center justify-center gap-2 lg:gap-4">
          @each(link in navLinks)
            <li>
              @!link({
                route: link.route,
                text: link.label,
              })
            </li>
          @end
        </ul>
      </nav>
      {{--
        =====================================================
        RÉSEAUX SOCIAUX TABLETTE / DESKTOP
        =====================================================
      --}}
      <div class="hidden shrink-0 items-center justify-end gap-4 md:flex">
        @include('partials/social-icon')
      </div>
      {{--
        =====================================================
        BOUTON BURGER MOBILE
        =====================================================
      --}}
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="relative flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full text-dark transition-transform duration-200 active:scale-90 md:hidden"
      >
        {{-- BURGER --}}
        <svg
          data-menu-icon="open"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 512 512"
          fill="currentColor"
          aria-hidden="true"
          class="absolute size-5 rotate-0 scale-100 opacity-100 transition-[opacity,transform] duration-300 ease-out"
        >
          <path
            d="M0 96C0 78.3 14.3 64 32 64l384 0c17.7 0 32 14.3 32 32s-14.3 32-32 32L32 128C14.3 128 0 113.7 0 96zM64 256c0-17.7 14.3-32 32-32l384 0c17.7 0 32 14.3 32 32s-14.3 32-32 32L96 288c-17.7 0-32-14.3-32-32zM448 416c0 17.7-14.3 32-32 32L32 448c-17.7 0-32-14.3-32-32s14.3-32 32-32l384 0c17.7 0 32 14.3 32 32z"
          />
        </svg>
        {{-- X --}}
        <svg
          data-menu-icon="close"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 384 512"
          fill="currentColor"
          aria-hidden="true"
          class="absolute size-5 rotate-90 scale-75 opacity-0 transition-[opacity,transform] duration-300 ease-out"
        >
          <path
            d="M55.1 73.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L147.2 256 9.9 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192.5 301.3 329.9 438.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.8 256 375.1 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192.5 210.7 55.1 73.4z"
          />
        </svg>
      </button>
    </div>
    {{--
      =====================================================
      MENU MOBILE
      =====================================================
    --}}
    <div
      id="mobile-menu"
      class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-out md:hidden"
    >
      <div class="w-full overflow-hidden">
        <nav class="w-full px-5 pb-6 pt-2" aria-label="Navigation mobile">
          <ul class="flex w-full flex-col">
            @each(link in navLinks)
              <li class="w-full">
                @!link({
                  route: link.route,
                  text: link.label,
                  class:
                    'flex min-h-14 w-full items-center justify-center rounded-none px-0 py-0 text-lg',
                })
              </li>
            @end
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>
