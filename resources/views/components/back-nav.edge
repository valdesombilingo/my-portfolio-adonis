<div class="sticky top-4 z-40 px-4 sm:px-8 lg:px-10">
  <div class="mx-auto w-full max-w-5xl">
    <a
      id="back-nav-container"
      href="{{ href || route('projects') }}"
      up-back
      class="group inline-flex h-11 w-11 items-center justify-center font-body text-sm font-medium text-dark transition-[background-color,backdrop-filter,border-radius,color] duration-300 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dark-gray active:scale-90 sm:h-auto sm:w-auto sm:gap-2 sm:px-5 sm:py-3 md:active:scale-100 lg:hover:text-dark"
      aria-label="{{ label || 'Retour' }}"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 256 512"
        fill="currentColor"
        aria-hidden="true"
        class="size-5 shrink-0 md:size-3"
      >
        <path
          d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L77.3 256 214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"
        />
      </svg>

      <span class="hidden whitespace-nowrap sm:inline">{{ label || 'Retour' }}</span>
    </a>
  </div>
</div>
