@let(linkTextFromSlot = await $slots.main())
@let(linkText = linkTextFromSlot?.trim() || $props.get('text') || 'Lien')
@let(linkHref =
  $props.get('href') ||
  ($props.get('route')
    ? urlFor($props.get('route'), $props.get('routeParams'), $props.get('routeOptions'))
    : '#'))
@let(isActive = request.url() === linkHref)
@let(baseClasses =
  'px-4 py-2 text-sm font-body font-medium transform transition-transform duration-150 ease-in-out')
@let(stateClasses = isActive ? 'text-gray-custom' : 'text-dark')

<a
  href="{{ linkHref }}"
  class="{{ baseClasses }} {{ stateClasses }}"
  aria-current="{{ isActive ? 'page' : null }}"
  {{
    $props
      .except(['href', 'text', 'route', 'routeParams', 'routeOptions'])
      .toAttrs()
  }}
>
  {{ linkText }}
</a>
