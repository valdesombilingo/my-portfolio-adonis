<!DOCTYPE html>
<html lang="fr" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @let(pageTitle =
      title || 'Valdes Ombilingo | Développeur web & marketeur digital à Kinshasa')
    @let(pageDescription =
      description ||
      'Portfolio de Valdes Ombilingo, développeur web et marketeur digital à Kinshasa (RDC). Découvrez ses projets, ses compétences et son parcours.')
    @let(socialImage = ogImage || 'https://valdesombilingo.com/images/meta/default-og.jpg')
    @let(socialImageAlt =
      ogImageAlt ||
      'Présentation du portfolio de Valdes Ombilingo, développeur web et marketeur digital')
    {{--
      =====================================================
      SEO PRINCIPAL
      =====================================================
    --}}
    <title>{{ pageTitle }}</title>

    <meta name="description" content="{{ pageDescription }}" />

    <meta name="robots" content="{{ robots || 'index, follow, max-image-preview:large' }}" />
    @if(canonical)
      <link rel="canonical" href="{{ canonical }}" />
    @end
    {{--
      =====================================================
      OPEN GRAPH — PARTAGE SOCIAL
      =====================================================
    --}}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Valdes Ombilingo" />
    <meta property="og:locale" content="fr_FR" />

    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    @if(canonical)
      <meta property="og:url" content="{{ canonical }}" />
    @end

    <meta property="og:image" content="{{ socialImage }}" />
    <meta property="og:image:alt" content="{{ socialImageAlt }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {{--
      =====================================================
      X / TWITTER CARD — PARTAGE SOCIAL
      =====================================================
    --}}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />
    <meta name="twitter:image" content="{{ socialImage }}" />
    <meta name="twitter:image:alt" content="{{ socialImageAlt }}" />
    {{--
      =====================================================
      POLICES — FONTS
      =====================================================
    --}}
    <link
      rel="preload"
      href="/fonts/syne/Syne-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {{--
      =====================================================
      ICÔNES — NAVIGATEUR ET APPAREILS
      =====================================================
    --}}
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    @stack('head')
    {{--
      =====================================================
      ASSETS
      =====================================================
    --}}
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>

  <body class="bg-light-beige">
    <div id="page" up-main>
      @include('partials/header')

      <div data-page-reveal>
        {{{ await $slots.main() }}}
        @include('partials/footer')
      </div>
    </div>
  </body>
</html>
